# Copy this file to .env and fill in your values
# Never commit .env to git

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (elevenlabs.io → Profile → API Key)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Pexels (pexels.com/api — free stock footage for trending videos)
PEXELS_API_KEY=...

# YouTube (console.cloud.google.com → YouTube Data API v3)
YOUTUBE_API_KEY=...
YT_CHANNEL_ID=UCxxxxxx

# Airtable — optional logging (airtable.com)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Email digest
ALERT_EMAIL=you@email.com
DIGEST_EMAIL=you@email.com

#Gemini API Key
GEMINI_API_KEY=AIza...

# Groq (console.groq.com/keys — free-tier script generation for trending/family/english)
GROQ_API_KEY=
# English 3-part scripts: pause between Groq calls (free tier TPM ~12k). 0 = disable.
GROQ_PART_COOLDOWN_SEC=25
# Max completion tokens per English part (default 4096; lower if you still hit 429)
GROQ_ENGLISH_MAX_TOKENS=4096
# Nano Banana Pro (optional) — create custom English thumbnails from title + concept
# Image generation for thumbnails (optional)
# Preferred: Gemini image generation (use your Gemini API key)
GEMINI_IMAGE_MODEL=gemini-2.5-flash
GEMINI_IMAGE_API_URL=https://generative.googleapis.com/v1/images:generate
GEMINI_IMAGE_TIMEOUT=90
# If you have a Nano Banana Pro key and prefer that service instead, set:
#NANO_BANANA_PRO_API_KEY=
#NANO_BANANA_PRO_API_URL=https://api.nanobanana.pro/v1/generate
# Facebook / Meta — Reel cross-posting for english-shorts and english-quiz.
# Reels are created as DRAFTs so the public publish time stays under manual
# control in Meta Business Suite. Facebook has no "unlisted" visibility for
# Page content, so a draft is the closest available equivalent.
# Validate with: python scripts/facebook_setup.py
FACEBOOK_PAGE_ID=
# PAGE access token (from the page's own row of /me/accounts), not the user token.
FACEBOOK_PAGE_ACCESS_TOKEN=
# DRAFT | SCHEDULED | PUBLISHED  (default: DRAFT)
#FACEBOOK_REEL_STATE=DRAFT
# Reel caption: "title" reuses the YouTube title (shorts titles are already
# hooks). "description" uses the description's first paragraph instead.
#FACEBOOK_CAPTION_STYLE=title
# Facebook does not linkify URLs in captions, so the YouTube link is omitted by
# default rather than burning caption characters on something unclickable.
#FACEBOOK_APPEND_YOUTUBE_LINK=0
# Reels have no separate tags field, so the description's hashtags are lifted
# into the caption automatically (capped at 5). Set to 0 to suppress them.
#FACEBOOK_INCLUDE_HASHTAGS=1
# #Shorts is a YouTube format signal and is dropped from Reel captions. Set an
# empty value to keep it, or use REPLACE to substitute a Facebook tag.
#FACEBOOK_DROP_HASHTAGS=shorts
#FACEBOOK_REPLACE_HASHTAGS=#fbreels
# Engagement ask appended last. Set to an empty value to remove it entirely,
# or override with your own wording to A/B test. Comments, saves and shares
# carry more ranking weight than likes on Reels.
#FACEBOOK_ENGAGEMENT_CTA=Save this for your next conversation, share it with someone who needs it, and drop in the comments which one you'll use.
#FACEBOOK_GRAPH_VERSION=v26.0
#FACEBOOK_TIMEOUT=180
#FACEBOOK_ENABLED_CHANNELS=english-shorts,english-quiz
# The App Secret is intentionally NOT stored here. It is needed once, in a
# browser, to exchange a short-lived user token for a long-lived one. Nothing in
# the pipeline reads it.
#
# MINTING A PAGE TOKEN — order matters, and this is the recurring footgun:
#   1. short-lived user token (with pages_manage_posts, pages_read_engagement,
#      pages_show_list)
#   2. GET /oauth/access_token?grant_type=fb_exchange_token&client_id=<APP_ID>
#      &client_secret=<APP_SECRET>&fb_exchange_token=<SHORT_LIVED_TOKEN>   <- long-lived
#   3. GET /me/accounts?fields=id,name,access_token   (using the LONG-LIVED token)
#   4. put that page's access_token in FACEBOOK_PAGE_ACCESS_TOKEN above
# Skip step 2 and the Page token inherits the ~1 hour lifetime of the
# short-lived user token, then dies mid-run with error 190 / "permission(s) must
# be granted before impersonating a user's page".

# Local timezone used when scheduling English weekly challenge uploads.
LOCAL_TIMEZONE=America/Regina

FFMPEG_CMD=ffmpeg_static
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Chrome AI Scraper (for automated image generation)
# Path to Chrome user profile with logged-in Google accounts
CHROME_PROFILE_PATH=/Users/kanwal/Library/Application Support/Google/Chrome/Default
# Run browser in headless mode (false = visible for debugging)
CHROME_AI_HEADLESS=false
# Delay between image generations (seconds) to avoid rate limits
CHROME_AI_RATE_LIMIT_DELAY=30
# Max retry attempts per image generation
CHROME_AI_MAX_RETRIES=3
